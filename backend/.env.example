# ============================================================
# Deal2Pay AI — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- PayPal Sandbox Credentials ---
# Get from: https://developer.paypal.com/developer/applications
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- PayPal Webhook ---
# After creating the webhook in the PayPal Developer Dashboard,
# paste the Webhook ID here for signature verification.
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# --- Google Gemini ---
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Render PostgreSQL (External Database URL) ---
# Get from: Render Dashboard → PostgreSQL service → External Database URL
# Format: postgresql://USER:PASSWORD@HOST/DBNAME
DATABASE_URL=postgresql://deal2pay_user:CHANGE_ME@dpg-xxxxxxxxxxxx-a.oregon-postgres.render.com/deal2pay

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000
# Enable only for a controlled judge/demo environment. Exposes sample audit and
# simulated payment settlement endpoints; leave false in normal deployments.
DEAL2PAY_ENABLE_DEMO_ENDPOINTS=false
