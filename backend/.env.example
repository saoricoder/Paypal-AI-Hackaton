# ============================================================
# Deal2Pay AI — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- PayPal Sandbox Credentials ---
# Get from: https://developer.paypal.com/developer/applications
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- PayPal Webhook ---
# After creating the webhook in the PayPal Developer Dashboard,
# paste the Webhook ID here for signature verification.
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# --- OpenAI ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Supabase ---
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000
